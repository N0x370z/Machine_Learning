# Entornos virtuales
venv/
.venv/
env/

# Python
__pycache__/
*.pyc

# Sistema
.DS_Store

# Modelos grandes que se descargan aparte (ver README): el de MediaPipe
# (.task) y los de YOLO pose (.pt, se descargan solos).
models/*.task
models/*.pt

# Capturas de sesiones locales (CSVs y fotos), no forman parte del código.
capturas/*.csv
capturas/*.png
# Exportaciones para artículos (17-B: capturas/articulos/) y los Excel
# de la 19-A: pueden traer datos de participantes, no se suben.
capturas/*.xlsx
# Datos de cada sesión (17-D): participante, rutas de video...
capturas/*.json
capturas/articulos/

# Calibración estéreo (estereo.py): es de TUS cámaras y de dónde están
# puestas; en otra máquina no sirve. El tablero PNG se genera con
# "estereo.py tablero".
calibracion/

# Proyecto de Unreal (23-A, unreal/HandMotionUE): solo se suben el
# .uproject, Config/ y los scripts de Content/Python. Lo demás lo genera
# Unreal al abrirlo (cachés de shaders, registros, binarios).
unreal/HandMotionUE/Saved/
unreal/HandMotionUE/Intermediate/
unreal/HandMotionUE/DerivedDataCache/
unreal/HandMotionUE/Binaries/
unreal/HandMotionUE/Content/Python/__pycache__/

# Material de la piel (2026-11-24): lo crea handmotion_escena.py al abrir
# el proyecto, no hace falta subirlo.
unreal/HandMotionUE/Content/HandMotion/
